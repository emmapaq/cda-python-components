#####
# Configuration file for the Constrained Device App (CDA)
#
# This provides a section-based configuration format for use by
# ConfigUtil with keys defined in ConfigConst.
#
# IMPORTANT: Edit this file to meet your local system requirements.
#

#
# MQTT client configuration information
#
[Mqtt.GatewayService]
host = localhost
port = 1883
securePort = 8883
defaultQoS = 0
keepAlive = 60
enableAuth = False
enableCrypt = False

#
# CoAP client configuration information
#
[Coap.GatewayService]
credFile = ./cred/PiotCoapCred.props
certFile = ./cert/PiotCoapLocalCertFile.pem
host = localhost
port = 5683
securePort = 5684
enableAuth = False
enableCrypt = False

#
# GDA specific configuration information
#
[GatewayDevice]
deviceLocationID = gatewaydevice001
enableMqttClient = True
enableCoapServer = True
enableCoapClient = False
enableSystemPerformance = True
enableCloudClient = False
enableSmtpClient = False
enablePersistenceClient = False
enableLogging = True
pollCycleSecs = 5
testCdaHost = localhost
testCdaPort = 5683
testGdaDataPath = /tmp/gda-data
testCdaDataPath = /tmp/cda-data

#
# CDA specific configuration information
#
[ConstrainedDevice]
deviceLocationID = constraineddevice001
deviceName = ConstrainedDevice
defaultLocationID = constraineddevice001
sensorDefaultName = DefaultSensor

# Enable/Disable features
enableEmulator = False
enableSenseHAT = False
enableMqttClient = True
enableCoapServer = False
enableCoapClient = False
enableSystemPerformance = True
enableSensing = True
enableLogging = True
testEmptyApp = False

# Polling and paths
pollCycleSecs = 5
testGdaDataPath = /tmp/gda-data
testCdaDataPath = /tmp/cda-data

# Configurable limits for sensor simulation
humiditySimFloor = 35.0
humiditySimCeiling = 45.0
pressureSimFloor = 985.0
pressureSimCeiling = 1015.0
tempSimFloor = 18.0
tempSimCeiling = 22.0

# Configurable limits for actuator triggers
handleTempChangeOnDevice = True
triggerHvacTempFloor = 18.0
triggerHvacTempCeiling = 20.0

# Camera settings
streamHostAddr = 127.0.0.1
streamHostLabel = localhost
streamPort = 8554
streamProtocol = rtsp
streamPath = stream
streamEncoding = MJPG
streamFrameWidth = 1440
streamFrameHeight = 1080
streamFps = 30
imageFileExt = .png
videoFileExt = .avi
minMotionPixelsDiff = 10000

#
# SMTP (email) configuration
#
[Smtp.GatewayService]
host = smtp.gmail.com
port = 587
enableAuth = True